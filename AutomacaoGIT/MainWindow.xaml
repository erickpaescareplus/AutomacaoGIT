 <Window x:Class="AutomacaoGIT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomacaoGIT"
        mc:Ignorable="d"
        Title="Mufasa Automações" 
        Height="750" 
        Width="1300" 
        MinWidth="1100" 
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Icon="imgs/mufasa.png"
        Background="#FAFAFA">
    
    
    <Window.Resources>
        <!-- ===== CORES PRINCIPAIS ===== -->
        <SolidColorBrush x:Key="PrimaryOrange" Color="#FF6B35"/>
        <SolidColorBrush x:Key="PrimaryOrangeDark" Color="#E85A2A"/>
        <SolidColorBrush x:Key="PrimaryOrangeLight" Color="#FF7F4D"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFB399"/>
        
        <SolidColorBrush x:Key="BackgroundLight" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#F5F5F5"/>
        
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#999999"/>
        
        <SolidColorBrush x:Key="BorderLight" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="BorderMedium" Color="#CCCCCC"/>
        
        <!-- ===== GRADIENTES MODERNOS ===== -->
        <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B35" Offset="0"/>
            <GradientStop Color="#FF8A5B" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="OrangeGradientReverse" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A5B" Offset="0"/>
            <GradientStop Color="#FF6B35" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== ESTILO PARA LABELS ===== -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ===== ESTILO PARA TEXTBOX MODERNO ===== -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FAFAFA"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryOrange}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Margin" Value="-1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA COMBOBOX MODERNO ===== -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Focusable="False"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FAFAFA"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryOrange}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource PrimaryOrange}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="12,0,32,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MaxHeight="300"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA BOTÃO PRIMÁRIO (PREMIUM) ===== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OrangeGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#FF6B35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource OrangeGradientReverse}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#FF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA BOTÃO SECUNDÁRIO ===== -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E53E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#E53E3E"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C53030"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA BOTÃO TERCIÁRIO (OUTLINE) ===== -->
        <Style x:Key="TertiaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FAFAFA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryOrange}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryOrange}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA BOTÃO BROWSE (COMPACTO E ELEGANTE) ===== -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#FF6B35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryOrangeDark}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#FF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D54E1F"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ESTILO PARA CHECKBOX MODERNO ===== -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header Premium com Gradiente -->
        <Border Height="80" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF6B35" Offset="0"/>
                    <GradientStop Color="#FF8A5B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="40,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo Mufasa PNG com Clip para Arredondar -->
                    <Border Width="52" Height="52" CornerRadius="26" 
                            Background="White" 
                            Margin="0,0,20,0"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                        </Border.Effect>
                        <Border.Clip>
                            <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                        </Border.Clip>
                        <Image Source="imgs/mufasa.png" 
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mufasa Automações" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="White"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text=""
                                   FontSize="13" 
                                   FontWeight="Medium"
                                   Foreground="#FFFFFF"
                                   Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Badge de Versão -->
                <Border HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="12"
                        Padding="12,6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock Text="v1.0 Beta" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                </Border>
            </Grid>
        </Border>

        <!-- TabControl Moderno -->
        <TabControl Margin="32,96,32,32" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <!-- Estilo Premium para TabItem -->
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="24,12"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" 
                                        Background="{TemplateBinding Background}" 
                                        BorderThickness="0"
                                        CornerRadius="12,12,0,0" 
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}">
                                    <ContentPresenter ContentSource="Header" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Surface}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryOrange}"/>
                                        <Setter TargetName="Border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource Surface}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            
            <!-- ABA 1: Gerenciador de Branches -->
            <TabItem Header="🌿 Gerenciador de Branches">
                <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" MinWidth="400"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA - Formulário de Configuração -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Formulário de Entrada -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <Border Background="White" CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="⚙️ Configuração do Repositório" FontSize="18" FontWeight="Bold" 
                                       Foreground="#D35400" Margin="0,0,0,20"/>

                            <!-- Projeto -->
                            <Label Content="📦 Projeto" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CmbProject" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,0,12" SelectedIndex="0" 
                                      SelectionChanged="CmbProject_SelectionChanged">
                                <ComboBoxItem Content="-- Selecione um projeto --" 
                                              Tag="" 
                                              Foreground="#95A5A6"
                                              FontStyle="Italic"/>
                                <ComboBoxItem Content="CORE - Credenciamento Prestador Cadastro API" 
                                              Tag="https://github.com/CareplusBR/credenciamento-prestador-cadastro-api"/>
                                <ComboBoxItem Content="BFF - Credenciamento Prestador Cadastro BFF API" 
                                              Tag="https://github.com/CareplusBR/credenciamento-prestador-cadastro-bff-api"/>
                                <ComboBoxItem Content="WEB - Credenciamento Prestador Cadastro Web" 
                                              Tag="https://github.com/CareplusBR/credenciamento-prestador-cadastro-web"/>
                            </ComboBox>

                            <!-- URL do Repositório -->
                            <Label Content="🔗 URL do Repositório Git" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtRepositoryUrl" Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True" Background="#ECF0F1" Margin="0,0,0,12"
                                     Text=""/>

                            <!-- Caminho Local Base -->
                            <Label Content="📂 Caminho Local Base" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtLocalBasePath" Grid.Column="0" 
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="C:\Projetos"/>
                                <Button Grid.Column="2" Content="📁 Procurar" 
                                        Style="{StaticResource BrowseButtonStyle}"
                                        MinWidth="120"
                                        Click="BtnBrowseFolder_Click"/>
                            </Grid>

                            <!-- Branch Feature Base -->
                            <Label Content="🌿 Branch Feature Base" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbFeatureBranch" Grid.Column="0"
                                          Style="{StaticResource ComboBoxStyle}"
                                          SelectedIndex="0"/>
                                <Button x:Name="BtnConfigureGitHub" Grid.Column="2" 
                                        Content="🔐 Token" 
                                        Style="{StaticResource BrowseButtonStyle}"
                                        MinWidth="120"
                                        Click="BtnConfigureGitHub_Click"
                                        ToolTip="Configurar Token do GitHub para repositórios privados"/>
                            </Grid>

                            <!-- Nome da WIT -->
                            <Label Content="🏷️ Nome da WIT" Style="{StaticResource LabelStyle}">
                                <Label.ToolTip>
                                    <ToolTip Content="Informe o identificador da Work Item (WIT)" 
                                             Background="#2C3E50" Foreground="White"/>
                                </Label.ToolTip>
                            </Label>
                            <TextBox x:Name="TxtWitName" Style="{StaticResource TextBoxStyle}"
                                     Margin="0,0,0,8" Text=""/>

                            <!-- Apenas Clonar (sem criar WIT) -->
                            <CheckBox x:Name="ChkCloneOnly" 
                                      Content="📥 Apenas Clonar (sem criar branch WIT)" 
                                      Style="{StaticResource CheckBoxStyle}"
                                      FontSize="12"
                                      Margin="0,0,0,12"
                                      Checked="ChkCloneOnly_Changed"
                                      Unchecked="ChkCloneOnly_Changed"
                                      ToolTip="Marque para apenas clonar o repositório na feature selecionada, sem criar uma nova branch WIT"/>

                            <!-- Editor para Abrir -->
                            <Label Content="💻 Editor para Abrir" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="RbVisualStudio" Content="Visual Studio" 
                                             IsChecked="True" Margin="0,0,20,0"
                                             FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RbVisualStudioCode" Content="Visual Studio Code" 
                                             FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Botões de Ação -->
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Stretch">
                    <Button x:Name="BtnExecute" Content="🚀 Executar Automação" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="45" Margin="0,5"
                            Click="BtnExecute_Click"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCancel" Content="⛔ Cancelar" Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40" Margin="0,5"
                                Click="BtnCancel_Click" IsEnabled="False"/>
                        <Button x:Name="BtnClearLogs" Content="🗑️ Limpar Logs" Grid.Column="2"
                                Style="{StaticResource TertiaryButtonStyle}"
                                Height="40" Margin="0,5"
                                Click="BtnClearLogs_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- COLUNA DIREITA - Logs de Execução -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header dos Logs -->
                    <Border Grid.Row="0" Background="#D35400" CornerRadius="8,8,0,0" Padding="20,12">
                        <Grid>
                            <TextBlock Text="📋 Logs de Execução" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock Text="[MUFASA MODE]" FontSize="11" Foreground="#FDEBD0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Conteúdo dos Logs -->
                    <Border Grid.Row="1" Padding="15" Background="#FFFAF5">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLogs" FontFamily="Consolas" FontSize="11" 
                                      TextWrapping="NoWrap" Padding="10" Foreground="#D35400"
                                      Background="Transparent"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
                </Grid>
            </TabItem>
            
            <!-- ABA 2: Gerador de Prompt -->
            <TabItem Header="✨ Gerador de Prompt">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500" MinWidth="400"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUNA ESQUERDA - Configurações do Prompt -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <Border Background="White" CornerRadius="8" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                                </Border.Effect>

                                <StackPanel>
                                    <TextBlock Text="⚙️ Configuração do Prompt" FontSize="18" FontWeight="Bold" 
                                               Foreground="#D35400" Margin="0,0,0,20"/>

                                    <!-- Tipo de Projeto -->
                                    <Label Content="📦 Tipo de Projeto" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="CmbPromptProjectType" Style="{StaticResource ComboBoxStyle}"
                                              Margin="0,0,0,12" SelectedIndex="0"
                                              SelectionChanged="CmbPromptProjectType_SelectionChanged">
                                        <ComboBoxItem Content="CORE - API de Cadastro"/>
                                        <ComboBoxItem Content="BFF - API Gateway"/>
                                        <ComboBoxItem Content="WEB - Interface Web (Em Breve)" 
                                                      IsEnabled="False" 
                                                      Foreground="#95A5A6"
                                                      FontStyle="Italic"/>
                                    </ComboBox>

                                    <!-- Nome do Controller -->
                                    <Label Content="🎯 Nome do Controller" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TxtPromptControllerStandalone" Style="{StaticResource TextBoxStyle}"
                                             Margin="0,0,0,12" Text="ProviderRegister"/>
                                    
                                    <!-- Nome da Tabela (apenas para CORE) -->
                                    <StackPanel x:Name="TableNameSectionStandalone" Visibility="Visible">
                                        <Label Content="🗄️ Nome da Tabela" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtPromptTableNameStandalone" Style="{StaticResource TextBoxStyle}"
                                                 Margin="0,0,0,12" Text="TB_PROVIDER_CITY"/>
                                    </StackPanel>

                                    <!-- Tipo de Endpoint -->
                                    <Label Content="🔗 Tipo de Endpoint" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="CmbEndpointTypeStandalone" Style="{StaticResource ComboBoxStyle}"
                                              Margin="0,0,0,12" SelectedIndex="0">
                                        <ComboBoxItem Content="Get"/>
                                        <ComboBoxItem Content="Post"/>
                                        <ComboBoxItem Content="Put"/>
                                        <ComboBoxItem Content="Delete"/>
                                    </ComboBox>

                                    <!-- Nome do Endpoint -->
                                    <Label Content="📌 Nome do Endpoint" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TxtPromptEndpointStandalone" Style="{StaticResource TextBoxStyle}"
                                             Margin="0,0,0,12" Text="City"/>

                                    <!-- Nome do Método -->
                                    <Label Content="⚡ Nome do Método" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TxtPromptMethodStandalone" Style="{StaticResource TextBoxStyle}"
                                             Margin="0,0,0,12" Text="GetCity"/>

                                    <!-- Colunas/Propriedades -->
                                    <Label Content="📊 Colunas/Propriedades" Style="{StaticResource LabelStyle}" Margin="0,10,0,4"/>
                                    
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel x:Name="ColumnsContainerStandalone">
                                                <!-- Campo inicial -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBox Grid.Column="0" x:Name="TxtColumnNameStandalone1" 
                                                             Style="{StaticResource TextBoxStyle}"
                                                             Tag="ColumnName"
                                                             Text="ID_CIDADE"/>
                                                    
                                                    <ComboBox Grid.Column="2" x:Name="CmbColumnTypeStandalone1"
                                                              Style="{StaticResource ComboBoxStyle}"
                                                              Tag="ColumnType"
                                                              SelectedIndex="0">
                                                        <ComboBoxItem Content="int"/>
                                                        <ComboBoxItem Content="string"/>
                                                        <ComboBoxItem Content="bool"/>
                                                        <ComboBoxItem Content="decimal"/>
                                                        <ComboBoxItem Content="DateTime"/>
                                                        <ComboBoxItem Content="Guid"/>
                                                        <ComboBoxItem Content="long"/>
                                                        <ComboBoxItem Content="double"/>
                                                    </ComboBox>
                                                    
                                                    <Button Grid.Column="4" Content="➖" 
                                                            Width="30" Height="30"
                                                            Background="#E74C3C" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand"
                                                            FontWeight="Bold" FontSize="14"
                                                            Click="BtnRemoveColumnStandalone_Click"
                                                            Visibility="Collapsed">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#C0392B"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                            
                                            <Button x:Name="BtnAddColumnStandalone" Content="➕ Adicionar Coluna" 
                                                    Background="#3498DB" Foreground="White"
                                                    Padding="10,8" Margin="0,5,0,0"
                                                    BorderThickness="0" Cursor="Hand"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    Click="BtnAddColumnStandalone_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2980B9"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Botões de Ação -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Stretch">
                            <Button x:Name="BtnGeneratePrompt" Content="✨ Gerar Prompt" 
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="45" Margin="0,5"
                                    Click="BtnGeneratePrompt_Click"/>
                            <Button x:Name="BtnSavePromptToFile" Content="💾 Salvar Prompt em Arquivo" 
                                    Style="{StaticResource TertiaryButtonStyle}"
                                    Height="40" Margin="0,5"
                                    Click="BtnSavePromptToFile_Click"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- COLUNA DIREITA - Prompt Gerado -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header do Prompt -->
                            <Border Grid.Row="0" Background="#D35400" CornerRadius="8,8,0,0" Padding="20,12">
                                <Grid>
                                    <TextBlock Text="📄 Prompt Gerado" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left"/>
                                    <TextBlock Text="[COPILOT READY]" FontSize="11" Foreground="#FDEBD0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Conteúdo do Prompt -->
                            <Border Grid.Row="1" Padding="15" Background="#FFFAF5">
                                <ScrollViewer x:Name="PromptScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtGeneratedPrompt" FontFamily="Consolas" FontSize="11" 
                                              TextWrapping="Wrap" Padding="10" Foreground="#2C3E50"
                                              Background="Transparent"
                                              Text="Aguardando geração do prompt..."/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- ABA 3: Testes Automatizados (Em Breve - Desabilitada) -->
            <TabItem IsEnabled="False">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧪 Testes Automatizados" 
                                   Foreground="#CCCCCC"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <Border Background="#FFEBCD" 
                                CornerRadius="8" 
                                Padding="6,2" 
                                Margin="8,0,0,0">
                            <TextBlock Text="Em Breve" 
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="#FF8C00"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Border Background="White" CornerRadius="8" Padding="40" Margin="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🚧" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Em Breve" FontSize="28" FontWeight="Bold" Foreground="#D35400" HorizontalAlignment="Center"/>
                            <TextBlock Text="Funcionalidade de Testes Automatizados" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
