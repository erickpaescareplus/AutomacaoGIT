<Window x:Class="AutomacaoGIT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutomacaoGIT"
        mc:Ignorable="d"
        Title="Automação Git - Desenvolvimento" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    
    <Window.Resources>
        <!-- Estilo para Labels -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Estilo para TextBox -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2980B9"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para Botão Primário -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#229954"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#95A5A6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão Secundário -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A93226"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão Terciário -->
        <Style x:Key="TertiaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#707B7C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Botão Browse -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2471A3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#2C3E50" Height="70" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
                <TextBlock Text="🚀" FontSize="32" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="Automação Git" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Gerenciador de Branches e Repositórios" FontSize="12" Foreground="#BDC3C7" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Margin="30,90,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Formulário de Entrada -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Border.Effect>
                
                <StackPanel>
                    <TextBlock Text="⚙️ Configuração do Repositório" FontSize="18" FontWeight="Bold" 
                               Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna Esquerda -->
                        <StackPanel Grid.Column="0">
                            <Label Content="📦 Projeto" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CmbProject" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,0,12" SelectedIndex="0" 
                                      SelectionChanged="CmbProject_SelectionChanged">
                                <ComboBoxItem Content="CORE - Credenciamento Prestador Cadastro API" 
                                              Tag="https://github.com/CareplusBR/credenciamento-prestador-cadastro-api"/>
                                <ComboBoxItem Content="BFF - Credenciamento Prestador Cadastro BFF API" 
                                              Tag="https://github.com/CareplusBR/credenciamento-prestador-cadastro-bff-api"/>
                            </ComboBox>

                            <Label Content="🔗 URL do Repositório Git" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtRepositoryUrl" Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True" Background="#ECF0F1" Margin="0,0,0,12"
                                     Text="https://github.com/CareplusBR/credenciamento-prestador-cadastro-api"/>

                            <Label Content="📂 Caminho Local Base" Style="{StaticResource LabelStyle}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtLocalBasePath" Grid.Column="0" 
                                         Style="{StaticResource TextBoxStyle}"
                                         Text="C:\Projetos"/>
                                <Button Grid.Column="2" Content="📁 Procurar" 
                                        Style="{StaticResource BrowseButtonStyle}"
                                        Click="BtnBrowseFolder_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Coluna Direita -->
                        <StackPanel Grid.Column="2">
                            <Label Content="🌿 Branch Feature Base" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CmbFeatureBranch" Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,0,0,12" SelectedIndex="0"/>

                            <Label Content="🏷️ Nome da WIT" Style="{StaticResource LabelStyle}">
                                <Label.ToolTip>
                                    <ToolTip Content="Informe o identificador da Work Item (WIT)" 
                                             Background="#2C3E50" Foreground="White"/>
                                </Label.ToolTip>
                            </Label>
                            <TextBox x:Name="TxtWitName" Style="{StaticResource TextBoxStyle}"
                                     Margin="0,0,0,12" Text=""/>

                            <Label Content="🤖 Prompt para IA (em breve)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtAIPrompt" Padding="10,8" FontSize="13"
                                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     IsEnabled="False" Background="#ECF0F1" BorderBrush="#BDC3C7"
                                     BorderThickness="1" VerticalScrollBarVisibility="Auto"
                                     Text="🚧 Funcionalidade em desenvolvimento..."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Área de Logs -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="0" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header dos Logs -->
                    <Border Grid.Row="0" Background="#34495E" CornerRadius="8,8,0,0" Padding="20,12">
                        <TextBlock Text="📋 Logs de Execução" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Conteúdo dos Logs -->
                    <Border Grid.Row="1" Padding="15" Background="#FAFAFA">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLogs" FontFamily="Consolas" FontSize="12" 
                                      TextWrapping="Wrap" Padding="10" Foreground="#2C3E50"
                                      Background="Transparent"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Botões de Ação -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnExecute" Content="🚀 Executar Automação" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="220" Height="45" Margin="5"
                        Click="BtnExecute_Click"/>
                <Button x:Name="BtnCancel" Content="⛔ Cancelar" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="140" Height="45" Margin="5"
                        Click="BtnCancel_Click" IsEnabled="False"/>
                <Button x:Name="BtnClearLogs" Content="🗑️ Limpar Logs" 
                        Style="{StaticResource TertiaryButtonStyle}"
                        Width="140" Height="45" Margin="5"
                        Click="BtnClearLogs_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
